{
  "compile": {
    "workers": 8,
    "objects_workers": 8,
    "interactions_workers": 8,
    "block_lists": 8,
    "agent": {
      "max_model_requests": 8,
      "max_tool_calls": 12,
      "max_block_retries": 3,
      "max_output_retries": 2,
      "max_run_seconds": 120,
      "max_keywords_per_search": 8,
      "max_search_results": 8,
      "max_tool_blocks": 32
    },
    "link": {
      "partition_max_input_bytes": 65536,
      "merge_max_input_bytes": 65536,
      "max_partition_calls": 64
    },
    "repair": {
      "enabled": true,
      "objects_max_rounds": 5,
      "interactions_max_rounds": 5
    },
    "request_limits": {
      "default": {
        "max_input_bytes": 16777216
      }
    },
    "context": {
      "max_tokens": 131072,
      "compact_at": 0.8,
      "compact_to": 0.5
    }
  },
  "llm": {
    "default": "local",
    "cache_dir": ".rsc-cache",
    "providers": {
      "local": {
        "api": "openai",
        "base_url": "http://127.0.0.1:8000/v1",
        "api_key": "local",
        "model": "local-model",
        "temperature": 0,
        "max_tokens": 16384,
        "structured_mode": "tool"
      }
    },
    "stages": {
      "objects": {
        "provider": "local"
      },
      "interactions": {
        "provider": "local"
      },
      "repair": {
        "provider": "local"
      },
      "link_partition": {
        "provider": "local"
      },
      "link_merge": {
        "provider": "local"
      }
    }
  }
}
