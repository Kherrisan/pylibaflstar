{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc.local/schemas/index.schema.json",
  "title": "RSC global index",
  "description": "Output of the index stage: section, entity, definition, reference and normative-convention indexes.",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "rfc": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generated_at": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "rfc",
        "input_sha256"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/indexed_block"
      }
    }
  },
  "required": [
    "meta",
    "sections",
    "references",
    "blocks"
  ],
  "additionalProperties": false,
  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "common.schema.json#/$defs/section_path"
        },
        "title": {
          "type": "string"
        },
        "span": {
          "$ref": "common.schema.json#/$defs/span"
        },
        "parent_section_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "section_id",
        "path",
        "title",
        "span"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "reference_id": {
          "type": "string",
          "minLength": 1
        },
        "from_block": {
          "type": "string",
          "minLength": 1
        },
        "ref_type": {
          "enum": [
            "section",
            "rfc",
            "term"
          ]
        },
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "target_section_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_rfc": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved": {
          "type": "boolean"
        },
        "span": {
          "$ref": "common.schema.json#/$defs/span"
        }
      },
      "required": [
        "reference_id",
        "from_block",
        "ref_type",
        "raw",
        "resolved",
        "span"
      ],
      "additionalProperties": false
    },
    "indexed_block": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "prev_block_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_block_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "block_id",
        "section_id",
        "order",
        "prev_block_id",
        "next_block_id"
      ],
      "additionalProperties": false
    }
  }
}
