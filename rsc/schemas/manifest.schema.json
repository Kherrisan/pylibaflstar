{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc.local/schemas/manifest.schema.json",
  "title": "RSC pipeline manifest",
  "description": "Run-level provenance for one RSC pipeline execution.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "rfc": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "rsc_version": {
      "type": "string",
      "minLength": 1
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "llm": {
      "$ref": "#/$defs/llm_usage"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "rfc",
    "input_sha256",
    "created_at",
    "rsc_version",
    "argv",
    "stages"
  ],
  "additionalProperties": false,
  "$defs": {
    "stage": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "ingest",
            "index",
            "compile",
            "objects",
            "interactions",
            "repair",
            "validate"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "complete",
            "failed",
            "skipped"
          ]
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "name",
        "status"
      ],
      "additionalProperties": false
    },
    "llm_usage": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "cache_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "cached_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
