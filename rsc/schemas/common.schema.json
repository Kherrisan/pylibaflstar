{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc.local/schemas/common.schema.json",
  "title": "RSC common definitions",
  "description": "Shared source spans and structural index definitions.",
  "$defs": {
    "span": {
      "type": "object",
      "description": "A range in the original source file. Offsets are 0-based; lines are 1-based.",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "source_id",
        "start",
        "end",
        "start_line",
        "end_line"
      ],
      "additionalProperties": false
    },
    "section_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
